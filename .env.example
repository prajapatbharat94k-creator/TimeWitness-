# ─────────────────────────────────────────────────────────────────────────────
# TimeWitness — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual credentials.
# .env.local is git-ignored and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini API Key ─────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
# SECURITY: Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase — PUBLIC (client-safe, included in browser bundle) ───────────────
# Found in: Supabase Dashboard → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ── Supabase — SERVER ONLY (never expose to the browser) ─────────────────────
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# Used only by: src/utils/supabase/admin.ts and scripts/fetch-wiki-corpus.mjs
# WARNING: This key bypasses Row Level Security. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Supabase Auth JWKS URL (optional — for server-side token verification) ───
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
